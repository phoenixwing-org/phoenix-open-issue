# 1Panel / 生产一体部署配置（复制为 .env）

PORT=3400
JWT_SECRET=change-me-in-production
INITIAL_ADMIN_PASSWORD=change-me-to-a-strong-password
DB_PATH=data/open-issue.sqlite
SERVE_STATIC=true

# 飞书登录（不启用时保持两个开关为 false，登录页不会显示入口）
THIRD_PARTY_LOGIN_ENABLED=false
THIRD_PARTY_ACCOUNT_MODE=bind_existing
FEISHU_LOGIN_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://issues.example.com/api/auth/oauth/feishu/callback
FEISHU_ALLOWED_TENANT_KEYS=
FEISHU_SCOPES=
# 一体部署留空表示同域；前后端分离时填写前端 HTTPS 根地址。
WEB_BASE_URL=
OAUTH_STATE_TTL_SECONDS=600
OAUTH_TICKET_TTL_SECONDS=120
