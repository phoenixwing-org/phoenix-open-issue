# SQLite 后端配置

PORT=3400
JWT_SECRET=change-me-in-production
INITIAL_ADMIN_PASSWORD=change-me-to-a-strong-password

# 相对 packages/server 目录；生产环境建议使用绝对路径。
DB_DRIVER=sqlite
DB_PATH=../../data/open-issue.sqlite

# build 后自动托管 packages/web/dist；前后端分离时设为 false。
# SERVE_STATIC=true
# STATIC_DIR=../web/dist

# 第三方登录默认关闭。启用飞书时两个开关都设为 true，并填写服务端凭据。
THIRD_PARTY_LOGIN_ENABLED=false
THIRD_PARTY_ACCOUNT_MODE=bind_existing
FEISHU_LOGIN_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:3400/api/auth/oauth/feishu/callback
# 生产环境必填；多个 tenant_key 使用英文逗号分隔。
FEISHU_ALLOWED_TENANT_KEYS=
FEISHU_SCOPES=
WEB_BASE_URL=http://localhost:5183
OAUTH_STATE_TTL_SECONDS=600
OAUTH_TICKET_TTL_SECONDS=120
