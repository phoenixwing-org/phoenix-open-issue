# PostgreSQL 后端配置

PORT=3400
JWT_SECRET=change-me-in-production
INITIAL_ADMIN_PASSWORD=change-me-to-a-strong-password

# 只配置 PostgreSQL，不要同时保留 DB_PATH。
DB_DRIVER=postgres
DATABASE_URL=postgresql://openissue:change-me@127.0.0.1:5432/phoenix-open-issue
DB_POOL_MAX=10
DB_SSL=false

# build 后自动托管 packages/web/dist；前后端分离时设为 false。
# SERVE_STATIC=true
# STATIC_DIR=../web/dist
