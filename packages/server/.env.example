# 后端配置（复制为 .env）

PORT=3400
JWT_SECRET=change-me-in-production

# SQLite 路径（相对 packages/server 目录）
# monorepo 开发: ../../data/open-issue.sqlite
# 独立/一体部署: data/open-issue.sqlite 或绝对路径
DB_PATH=../../data/open-issue.sqlite

# 启动时选择一种数据库；配置错误会阻止启动，不会回退到 SQLite。
# DB_DRIVER=sqlite
# DATABASE_URL=postgresql://openissue:password@127.0.0.1:5432/openissue
# DB_POOL_MAX=10
# DB_SSL=false

# 一体部署：build 后 server 自动托管 packages/web/dist（检测到 index.html 即开启）
# 仅跑 API、前后端分离部署时设为 false
# SERVE_STATIC=false

# 前端静态文件目录（相对 packages/server，默认 ../web/dist）
# STATIC_DIR=../web/dist
