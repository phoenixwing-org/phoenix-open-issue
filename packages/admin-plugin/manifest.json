    { "id": "phoenix-open-issue:test:read", "description": "查看 Issue 插件测试清单与结果", "risk": "read" },
    { "id": "phoenix-open-issue:test:run", "description": "在受控开发环境运行 Issue 插件测试", "risk": "admin" },
    { "id": "phoenix-open-issue:maintenance:read", "description": "查看 Issue 插件数据检查与修正计划", "risk": "read" },
    { "id": "phoenix-open-issue:maintenance:run", "description": "执行 Issue 插件声明的幂等数据修正", "risk": "admin" },
    { "id": "phoenix-open-issue:data:purge", "description": "永久清除插件业务数据", "risk": "admin" }
