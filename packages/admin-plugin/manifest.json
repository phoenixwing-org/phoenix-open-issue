    { "id": "phoenix-open-issue:issue:create", "description": "创建 Issue", "risk": "write" },
    { "id": "phoenix-open-issue:issue:update", "description": "更新 Issue", "risk": "write" },
    { "id": "phoenix-open-issue:issue:delete", "description": "删除 Issue", "risk": "admin" },
    { "id": "phoenix-open-issue:checkpoint:read", "description": "查看 Issue 点检项", "risk": "read" },
    { "id": "phoenix-open-issue:checkpoint:create", "description": "创建 Issue 点检项", "risk": "write" },
    { "id": "phoenix-open-issue:checkpoint:update", "description": "更新 Issue 点检项", "risk": "write" },
    { "id": "phoenix-open-issue:checkpoint:delete", "description": "作废 Issue 点检项", "risk": "write" },
    { "id": "phoenix-open-issue:push:read", "description": "查看有权访问的 Issue 推送记录", "risk": "read" },
    { "id": "phoenix-open-issue:push:create", "description": "发起 Issue 推送", "risk": "write" },
    { "id": "phoenix-open-issue:push:handle", "description": "接受、拒绝或撤回 Issue 推送", "risk": "write" },
    { "id": "phoenix-open-issue:report:read", "description": "查看 8D 报告", "risk": "read" },
    { "id": "phoenix-open-issue:report:write", "description": "创建或修改 8D 报告", "risk": "write" },
