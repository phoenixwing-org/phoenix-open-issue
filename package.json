{
  "name": "phoenix-open-issue",
  "version": "0.6.1",
  "author": "上海锟钛",
  "license": "Apache-2.0",
  "private": true,
  "description": "Open Issue List 管理 Web 应用 — 多列表协作、组织层级推送、点检追踪",
  "scripts": {
    "dev:core": "pnpm -C packages/core build --watch",
    "dev:server": "pnpm -C packages/server dev",
    "dev:web": "pnpm -C packages/web dev",
    "dev": "pnpm run dev:services",
    "dev:services": "concurrently -k -n core,server,web -c blue,green,magenta \"pnpm dev:core\" \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:local-wing": "node scripts/run-with-phoenix-wing.mjs -- pnpm run dev:services",
    "build:core": "pnpm -C packages/core build",
    "build:server": "pnpm -C packages/server build",
    "build:web": "pnpm -C packages/web build",
    "build": "pnpm build:core && pnpm build:server && pnpm build:web",
    "build:local-wing:consumers": "pnpm build:core && pnpm build:server && pnpm -C packages/web build:local-wing",
    "build:local-wing": "node scripts/run-with-phoenix-wing.mjs -- pnpm run build:local-wing:consumers",
    "build:deploy": "pnpm build:core && pnpm -C packages/web exec vite build",
    "start": "pnpm -C packages/server start",
    "start:prod": "NODE_ENV=production pnpm -C packages/server exec tsx src/main.ts",
    "deploy": "pnpm build:deploy && pnpm start:prod",
    "seed": "pnpm -C packages/server seed",
    "sqlite:inventory": "node scripts/inventory-legacy-sqlite.mjs",
    "sqlite:audit-cleanup": "node scripts/audit-sqlite-cleanup.mjs",
    "sqlite:audit-no-regression": "node scripts/audit-sqlite-cleanup.mjs --summary --baseline-check",
    "sqlite:verify-rehearsal": "node scripts/verify-sqlite-pg-rehearsal.mjs",
    "test": "vitest run",
    "test:pg": "vitest run tests/server/postgres-integration.test.ts",
    "verify:wing-dependencies": "node scripts/verify-wing-dependencies.mjs",
    "admin-plugin:sync-issue-ui": "node scripts/sync-admin-plugin-ui.mjs --apply",
    "admin-plugin:sync-issue-ui-missing": "node scripts/sync-admin-plugin-ui.mjs --apply --only-missing",
    "admin-plugin:adapt-issue-imports": "node scripts/adapt-admin-plugin-imports.mjs --apply",
    "admin-plugin:link-dev-host": "node scripts/link-admin-plugin-dev.mjs mount",
    "admin-plugin:mount-dev-host": "node scripts/link-admin-plugin-dev.mjs mount",
    "admin-plugin:status-dev-host": "node scripts/link-admin-plugin-dev.mjs status",
    "admin-plugin:unmount-dev-host": "node scripts/link-admin-plugin-dev.mjs unmount",
    "admin-plugin:verify-manifest": "node scripts/verify-admin-plugin-manifest.mjs",
    "admin-plugin:verify-settings-boundary": "node scripts/verify-admin-plugin-settings-boundary.mjs",
    "admin-plugin:build-browser-runtime": "node scripts/build-admin-plugin-browser-runtime.mjs",
    "admin-plugin:verify-browser-runtime": "node scripts/verify-admin-plugin-browser-runtime.mjs",
    "admin-plugin:verify-pack": "node scripts/verify-admin-plugin-pack.mjs",
    "admin-plugin:typecheck-vue": "node scripts/run-admin-plugin-vue-tool.mjs typecheck",
    "admin-plugin:typecheck-midway": "../phoenix-admin-node/node_modules/.bin/tsc -p packages/admin-plugin/midway/tsconfig.fixture.json",
    "admin-plugin:typecheck-vue-local-wing": "node scripts/typecheck-admin-plugin-with-phoenix-wing.mjs",
    "admin-plugin:test-core": "node scripts/run-admin-plugin-vue-tool.mjs test",
    "admin-plugin:verify-issue-closure": "node scripts/verify-admin-plugin-module-closure.mjs",
    "admin-plugin:verify-issue-ui": "node scripts/verify-admin-plugin-ui-fidelity.mjs",
    "admin-plugin:verify": "pnpm admin-plugin:verify-manifest && pnpm admin-plugin:verify-settings-boundary && pnpm admin-plugin:verify-browser-runtime && pnpm admin-plugin:verify-pack && pnpm admin-plugin:verify-issue-closure && pnpm admin-plugin:verify-issue-ui && pnpm admin-plugin:typecheck-midway && pnpm admin-plugin:typecheck-vue && pnpm admin-plugin:test-core",
    "admin-plugin:audit": "node scripts/audit-admin-plugin-migration.mjs",
    "wing:check-local": "node scripts/run-with-phoenix-wing.mjs --check",
    "docs:manifest": "node scripts/generate-doc-manifest.mjs",
    "docs:check": "node scripts/generate-doc-manifest.mjs --check",
    "verify:ci": "pnpm docs:check && pnpm verify:wing-dependencies && pnpm test && pnpm build",
    "verify:local-wing:consumers": "pnpm docs:check && pnpm verify:wing-dependencies && pnpm test && pnpm run build:local-wing:consumers",
    "verify:local-wing": "node scripts/run-with-phoenix-wing.mjs -- pnpm run verify:local-wing:consumers"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "concurrently": "^9.2.4",
    "vitest": "^4.1.10"
  }
}
